# ============================================================
# CINEFORGE environment — copy to .env and fill what you have.
# The studio runs end-to-end with ZERO keys (mock/local providers).
# NEVER commit the real .env file.
# ============================================================

# ---- LLM (canonical backend — live today, backend/app/core/config.py) ----
# openai-compatible wire format: works for Z.ai GLM, OpenAI, local vLLM…
LLM_PROVIDER=mock          # mock | zai | openai
LLM_BASE_URL=              # e.g. https://api.z.ai/api/paas/v4  (leave empty for mock)
LLM_API_KEY=
LLM_MODEL=glm-4-flash

# ---- Provider chains (packages/ai-providers — CF-012 upgrade layer) ----
# Used by the fallback-chain registry (workers / upcoming backend wiring).
# Name "mock" always resolves to the offline tier and is appended automatically.
CINEFORGE_LLM_CHAIN=zai,openai,anthropic,mock
CINEFORGE_IMAGE_CHAIN=openai,mock
CINEFORGE_TTS_CHAIN=openai,elevenlabs,mock
CINEFORGE_STT_CHAIN=openai,mock
CINEFORGE_MUSIC_CHAIN=mock
CINEFORGE_VIDEO_CHAIN=mock
ZAI_API_KEY=
ZAI_BASE_URL=
ZAI_MODEL=glm-4.6
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=tts-1
OPENAI_STT_MODEL=whisper-1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- Storage (canonical backend reads STORAGE_ROOT) ----
STORAGE_ROOT=./storage
CINEFORGE_MAX_PROJECT_MB=512

# ---- Database ----
# dev default: SQLite; production: PostgreSQL
DATABASE_URL=sqlite:///./cineforge.db
# DATABASE_URL=postgresql+psycopg://cineforge:cineforge@localhost:5432/cineforge

# ---- Queue (optional; without Redis the API uses its inline executor) ----
REDIS_URL=redis://localhost:6379/0

# ---- Web app ----
NEXT_PUBLIC_API_URL=http://localhost:8000
