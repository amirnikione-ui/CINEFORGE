# ============================================================
# CINEFORGE environment — copy to .env and fill what you have.
# The studio runs end-to-end with ZERO keys (mock/local providers).
# NEVER commit the real .env file.
# ============================================================

# ---- LLM providers (first available in the chain wins) ----
CINEFORGE_LLM_CHAIN=zai,openai,anthropic,mock
ZAI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# ---- Image generation ----
CINEFORGE_IMAGE_CHAIN=openai,mock
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Text-to-speech / narration ----
CINEFORGE_TTS_CHAIN=openai,elevenlabs,mock
ELEVENLABS_API_KEY=

# ---- Speech-to-text ----
CINEFORGE_STT_CHAIN=openai,mock

# ---- Music generation ----
CINEFORGE_MUSIC_CHAIN=mock

# ---- Text/video generation (M2+) ----
CINEFORGE_VIDEO_CHAIN=mock

# ---- Storage ----
CINEFORGE_STORAGE_ROOT=./storage
CINEFORGE_MAX_PROJECT_MB=512

# ---- Database ----
# dev default: SQLite; production: PostgreSQL
DATABASE_URL=sqlite:///./cineforge.db
# DATABASE_URL=postgresql+psycopg://cineforge:cineforge@localhost:5432/cineforge

# ---- Queue (optional; without Redis the API uses an inline executor) ----
REDIS_URL=redis://localhost:6379/0

# ---- Web app ----
NEXT_PUBLIC_API_URL=http://localhost:8000
