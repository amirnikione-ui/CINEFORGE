{
  "name": "@cineforge/remotion-template-cinematic-promo",
  "version": "0.1.0",
  "private": true,
  "description": "CINEFORGE storyboard-driven Remotion 4 template (CinematicPromo composition).",
  "scripts": {
    "render": "remotion render src/index.ts CinematicPromo out/cinematic-promo.mp4 --props=storyboard.example.json",
